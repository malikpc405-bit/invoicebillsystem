<script>
function toggleFilter() {
    var type = document.getElementById('filterType').value;
    var sels = {
        'daily': document.getElementById('filterDate'),
        'weekly': document.getElementById('filterWeek'),
        'monthly': document.getElementById('filterMonth'),
        'annual': document.getElementById('filterYear')
    };
    
    for (var key in sels) {
        if (key === type) {
            sels[key].style.display = 'inline-block';
            sels[key].disabled = false;
        } else {
            sels[key].style.display = 'none';
            sels[key].disabled = true;
        }
    }
}

function toggleDetails(id) {
    var el = document.getElementById('details-' + id);
    if (el.style.display === 'table-row') {
        el.style.display = 'none';
    } else {
        el.style.display = 'table-row';
    }
}

function changeReportItem(id, currentDesc, currentPrice, currentQty, currentDisc = 0) {
    const newDesc = prompt("Change Item Description:", currentDesc);
    if (newDesc === null) return;
    
    const newPrice = prompt("Change Price:", currentPrice);
    if (newPrice === null) return;
    
    const newQty = prompt("Change Quantity:", currentQty);
    if (newQty === null) return;

    const newDisc = prompt("Change Item Discount (%):", currentDisc);
    if (newDisc === null) return;
    
    fetch('update_bill_item.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            id: id,
            description: newDesc,
            price: parseFloat(newPrice),
            quantity: parseInt(newQty),
            discount_percent: parseFloat(newDisc) || 0
        })
    })
    .then(res => res.json())
    .then(data => {
        if (data.status === 'success') {
            alert("Item updated successfully!");
            location.reload();
        } else {
            alert("Error: " + data.error);
        }
    })
    .catch(err => alert("Failed to update item."));
}

function deleteBill(id) {
    if(!confirm('Are you sure you want to completely delete this bill and its records?')) return;
    fetch('delete_bill.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id })
    })
    .then(res => res.json())
    .then(data => {
        if(data.status === 'success') {
            location.reload();
        } else {
            alert('Error deleting bill: ' + data.error);
        }
    })
    .catch(err => alert('Network error'));
}

// Render Chart
const chartLabels = <?= json_encode($chartLabels) ?>;
const chartValues = <?= json_encode($chartValues) ?>;
const chartKeys = <?= json_encode($chartKeys) ?>;

if (chartLabels.length > 0) {
    const ctx = document.getElementById('reportChart').getContext('2d');
    
    let gradient = ctx.createLinearGradient(0, 0, 0, 400);
    gradient.addColorStop(0, 'rgba(16, 185, 129, 0.8)');
    gradient.addColorStop(1, 'rgba(16, 185, 129, 0.2)');

    // Use a line chart specifically for second-by-second (daily) data
    const chartType = '<?= $filterType === "daily" ? "line" : "bar" ?>';

    new Chart(ctx, {
        type: chartType,
        data: {
            labels: chartLabels,
            datasets: [{
                label: '<?= $filterMetric === "sales" ? "Total Sales (Rs.)" : "Profit (Rs.)" ?>',
                data: chartValues,
                backgroundColor: gradient,
                borderColor: '#10b981',
                borderWidth: 2,
                borderRadius: 6,
                borderSkipped: false,
                barPercentage: 0.6,
                pointBackgroundColor: '#ffffff',
                pointBorderColor: '#10b981',
                pointBorderWidth: 3,
                pointRadius: 8, // Very large so single points are highly visible
                pointHoverRadius: 12,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            onClick: (e, activeEls) => {
                if (activeEls.length > 0) {
                    const dataIndex = activeEls[0].index;
                    const clickedKey = chartKeys[dataIndex];
                    const currentType = '<?= $filterType ?>';
                    const currentMetric = '<?= $filterMetric ?>';
                    
                    if (currentType === 'weekly' || currentType === 'monthly') {
                        // Drill down to second-by-second Daily view
                        window.location.href = `reports.php?type=daily&date=${clickedKey}&metric=${currentMetric}`;
                    } else if (currentType === 'annual') {
                        // Drill down to Monthly view
                        window.location.href = `reports.php?type=monthly&month=${clickedKey}&metric=${currentMetric}`;
                    }
                }
            },
            interaction: {
                mode: 'index',
                intersect: false,
            },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: 'rgba(15, 23, 42, 0.9)',
                    titleFont: { size: 14, family: "'Inter', sans-serif" },
                    bodyFont: { size: 14, family: "'Inter', sans-serif" },
                    padding: 12,
                    cornerRadius: 8,
                    displayColors: false,
                    callbacks: {
                        label: function(context) {
                            return '<?= $filterMetric === "sales" ? "Sales" : "Profit" ?>: Rs. ' + context.parsed.y.toLocaleString(undefined, {minimumFractionDigits: 2});
                        }
                    }
                },
                title: { 
                    display: true, 
                    text: '<?= $filterMetric === "sales" ? "Sales Trend Over Time" : "Profit Trend Over Time" ?>',
                    font: { size: 16, family: "'Inter', sans-serif", weight: '600' },
                    color: '#0f172a',
                    padding: { top: 10, bottom: 20 }
                }
            },
            scales: {
                y: { 
                    beginAtZero: true,
                    grid: { color: '#f1f5f9', drawBorder: false },
                    ticks: {
                        font: { family: "'Inter', sans-serif", size: 12 },
                        color: '#64748b',
                        callback: function(value) { return 'Rs. ' + value; }
                    }
                },
                x: {
                    grid: { display: false, drawBorder: false },
                    ticks: {
                        font: { family: "'Inter', sans-serif", size: 12 },
                        color: '#64748b'
                    }
                }
            }
        }
    });
} else {
    document.querySelector('.chart-container').style.display = 'none';
}
</script>

</body>
</html>
